         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="360.0" minHeight="-Infinity" styleClass="user-dialog"
               wrapText="true" />
